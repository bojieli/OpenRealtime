+def _normalize_json_numbers(value):
+    """Canonicalize numerically equal JSON values for config identity.
+
+    Pydantic can round-trip a nested provider setting as ``100.0`` while the
+    same preset constructs it as ``100``. JSON assigns those values the same
+    numeric meaning; treating their representation as a changed experiment
+    makes an identical checkpoint impossible to resume.
+    """
+    if isinstance(value, float) and value.is_integer():
+        return int(value)
+    if isinstance(value, dict):
+        return {name: _normalize_json_numbers(entry) for name, entry in value.items()}
+    if isinstance(value, list):
+        return [_normalize_json_numbers(entry) for entry in value]
+    return value


