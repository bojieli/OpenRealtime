+        base_url="ws://127.0.0.1:8765/v1/realtime",
+    )
+
+    assert provider.voice == "fish-default"
+    assert provider.transcription_model == "local-asr"
+
+
+def test_explicit_base_url_requires_websocket_scheme(monkeypatch):
+    monkeypatch.setenv("OPENAI_REALTIME_API_KEY", "local-development-token")
+
+    with pytest.raises(ValueError, match="ws:// or wss://"):
+        OpenAIRealtimeProvider(
+            model="openrealtime-local",
+            base_url="http://127.0.0.1:8765/v1/realtime",
+        )
+
+
+def test_adapter_factory_propagates_explicit_base_url(monkeypatch):
+    monkeypatch.setenv("OPENAI_REALTIME_API_KEY", "local-development-token")
+
+    adapter, model = create_adapter(
+        provider="openai",
+        tick_duration_ms=200,
+        model="openrealtime-local",
+        base_url="ws://127.0.0.1:8765/v1/realtime",
+    )
+
+    assert model == "openrealtime-local"
+    assert adapter.provider.base_url == "ws://127.0.0.1:8765/v1/realtime"
+
+
+def test_adapter_factory_propagates_zero_ping_timeout(monkeypatch):
+    monkeypatch.setenv("OPENAI_REALTIME_API_KEY", "local-development-token")
+
+    adapter, _ = create_adapter(
+        provider="openai",
+        tick_duration_ms=200,
+        model="openrealtime-local",
+        base_url="ws://127.0.0.1:8765/v1/realtime",
+        openai_ping_timeout_seconds=0,
+    )
+
+    assert adapter.provider.ping_timeout_seconds == 0
+
+
+def test_negative_ping_timeout_is_rejected(monkeypatch):
+    monkeypatch.setenv("OPENAI_REALTIME_API_KEY", "local-development-token")
+
+    with pytest.raises(ValueError, match="ping timeout must be non-negative"):
+        OpenAIRealtimeProvider(
+            model="openrealtime-local",
+            base_url="ws://127.0.0.1:8765/v1/realtime",
+            ping_timeout_seconds=-1,
+        )
+
+
+def test_zero_ping_timeout_keeps_pings_without_disconnect_deadline(monkeypatch):
+    monkeypatch.setenv("OPENAI_REALTIME_API_KEY", "local-development-token")
+    connection = SimpleNamespace(
+        recv=AsyncMock(
+            return_value='{"type":"session.created","session":{"id":"session-1"}}'
+        )
+    )
+    connect = AsyncMock(return_value=connection)
+    monkeypatch.setattr(provider_module.websockets, "connect", connect)
+    provider = OpenAIRealtimeProvider(
+        model="openrealtime-local",
+        base_url="ws://127.0.0.1:8765/v1/realtime",
+        ping_timeout_seconds=0,
+    )
+
+    asyncio.run(provider.connect())
+
+    assert connect.await_args.kwargs["ping_timeout"] is None
+
+
