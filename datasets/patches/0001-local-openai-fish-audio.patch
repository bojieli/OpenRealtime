index 0000000..1b9eefd
--- /dev/null
+++ b/tests/test_voice/test_fish_audio_synthesis.py
@@ -0,0 +1,83 @@
+import httpx
+import pytest
+
+from tau2.data_model.voice import FishAudioTTSConfig, SynthesisConfig
+from tau2.voice.synthesis.voice_selection import resolve_synthesis_voice_id
+from tau2.voice.utils.fish_audio_utils import tts_fish_audio
+
+
+def test_fish_audio_uses_named_provider_and_returns_pcm16(monkeypatch):
+    captured = {}
+
+    def fake_post(url, *, headers, json, timeout):
+        captured.update(url=url, headers=headers, json=json, timeout=timeout)
+        return httpx.Response(
+            200,
+            content=b"\x01\x00\x02\x00",
+            headers={"X-Sample-Rate": "16000"},
+            request=httpx.Request("POST", url),
+        )
+
+    monkeypatch.setattr(httpx, "post", fake_post)
+    config = FishAudioTTSConfig(
+        endpoint="http://127.0.0.1:8081/v1/audio/speech",
+        model_id="fishaudio/s2-pro",
+        voice_id="control-voice",
+        source_sample_rate=16000,
+        output_sample_rate=16000,
+        seed=7,
+    )
+
+    audio = tts_fish_audio("hello", config)
+
+    assert audio.data == b"\x01\x00\x02\x00"
+    assert audio.format.is_pcm16
+    assert audio.format.sample_rate == 16000
+    assert captured["json"] == {
+        "model": "fishaudio/s2-pro",
+        "input": "hello",
+        "voice": "control-voice",
+        "response_format": "pcm",
+        "stream": False,
+        "seed": 7,
+    }
+
+
+def test_fish_audio_rejects_odd_pcm(monkeypatch):
+    def fake_post(url, *, headers, json, timeout):
+        return httpx.Response(
+            200,
+            content=b"\x01",
+            request=httpx.Request("POST", url),
+        )
+
+    monkeypatch.setattr(httpx, "post", fake_post)
+
+    with pytest.raises(ValueError, match="misaligned PCM16"):
+        tts_fish_audio("hello", FishAudioTTSConfig())
+
+
+def test_fish_audio_config_round_trip_preserves_provider():
+    config = SynthesisConfig(
+        provider="fish_audio",
+        provider_config=FishAudioTTSConfig(voice_id="local-control"),
+    )
+
+    restored = SynthesisConfig.model_validate(config.model_dump())
+
+    assert isinstance(restored.provider_config, FishAudioTTSConfig)
+    assert resolve_synthesis_voice_id(restored, "lisa_brenner") == "local-control"
+
+
+def test_fish_audio_resolves_persona_from_strict_registry():
+    config = SynthesisConfig(
+        provider="fish_audio",
+        provider_config=FishAudioTTSConfig(
+            voice_id="fallback",
+            voice_registry={"lisa_brenner": "fish-lisa"},
+        ),
+    )
+
+    assert resolve_synthesis_voice_id(config, "lisa_brenner") == "fish-lisa"
+    with pytest.raises(ValueError, match="no entry for persona"):
+        resolve_synthesis_voice_id(config, "matt_delaney")
