{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrealtime.dev/schemas/trace-record-v0.2.schema.json",
  "title": "OpenRealtime timed protocol trace record v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "session_id",
    "sequence",
    "monotonic_ns",
    "direction",
    "profile",
    "causal_parent_ids",
    "message"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0 },
    "monotonic_ns": { "type": "integer", "minimum": 0 },
    "direction": { "enum": ["client", "server"] },
    "profile": { "enum": ["realtime", "transcription", "translation", "beta"] },
    "causal_parent_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "message": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false
}
