+def load_string_map(path: str) -> dict[str, str]:
+    """Load a JSON object whose keys and values are non-empty strings."""
+    try:
+        value = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise argparse.ArgumentTypeError(
+            f"could not load JSON string map from {path}: {error}"
+        ) from error
+    if not isinstance(value, dict) or any(
+        not isinstance(key, str)
+        or not key
+        or not isinstance(item, str)
+        or not item
+        for key, item in value.items()
+    ):
+        raise argparse.ArgumentTypeError(
+            f"{path} must contain an object of non-empty string keys and values"
+        )
+    return value
+
+
