+++ b/src/tau2/voice/synthesis/voice_selection.py
@@ -0,0 +1,18 @@
+"""Provider-aware output voice selection for synthesized benchmark callers."""
+
+from tau2.data_model.voice import SynthesisConfig
+from tau2.data_model.voice_personas import get_elevenlabs_voice_id
+
+
+def resolve_synthesis_voice_id(
+    synthesis_config: SynthesisConfig, persona_name: str
+) -> str:
+    """Resolve a voice without treating one provider's IDs as another's."""
+    if synthesis_config.provider == "elevenlabs":
+        return get_elevenlabs_voice_id(persona_name)
+    voice_id = synthesis_config.provider_config.voice_id
+    if not voice_id:
+        raise ValueError(
+            f"Synthesis provider {synthesis_config.provider} requires a voice ID"
+        )
+    return voice_id
diff --git a/src/tau2/voice/utils/fish_audio_utils.py b/src/tau2/voice/utils/fish_audio_utils.py
new file mode 100644
index 0000000..88894b5
--- /dev/null
+++ b/src/tau2/voice/utils/fish_audio_utils.py
@@ -0,0 +1,57 @@
+"""Fish Audio synthesis through a local OpenAI-compatible speech endpoint."""
+
+import os
+
+import httpx
+
+from tau2.data_model.audio import AudioData, AudioEncoding, AudioFormat
+from tau2.data_model.voice import FishAudioTTSConfig
+from tau2.voice.utils.audio_preprocessing import resample_audio
+
+
+def tts_fish_audio(text: str, config: FishAudioTTSConfig) -> AudioData:
+    """Synthesize mono PCM16 with Fish Audio and normalize the sample rate."""
+    headers = {"Content-Type": "application/json", "Accept": "audio/pcm"}
+    api_key = os.getenv("FISH_AUDIO_API_KEY")
+    if api_key:
+        headers["Authorization"] = f"Bearer {api_key}"
+
+    payload = {
+        "model": config.model_id,
+        "input": text,
+        "voice": config.voice_id,
+        "response_format": "pcm",
+        "stream": False,
+    }
+    if config.seed is not None:
+        payload["seed"] = config.seed
+
+    response = httpx.post(
+        config.endpoint,
+        headers=headers,
+        json=payload,
+        timeout=config.request_timeout_seconds,
+    )
+    response.raise_for_status()
+    if not response.content or len(response.content) % 2:
+        raise ValueError("Fish Audio returned empty or misaligned PCM16 audio")
+
+    sample_rate_value = response.headers.get(
+        "X-Sample-Rate", str(config.source_sample_rate)
+    )
+    try:
+        sample_rate = int(sample_rate_value)
+    except ValueError as error:
+        raise ValueError("Fish Audio returned an invalid X-Sample-Rate") from error
+    if sample_rate <= 0:
+        raise ValueError("Fish Audio returned a non-positive sample rate")
+
+    audio = AudioData(
+        data=response.content,
+        format=AudioFormat(
+            encoding=AudioEncoding.PCM_S16LE,
+            sample_rate=sample_rate,
+            channels=1,
+        ),
+    )
+    return resample_audio(audio, config.output_sample_rate)
