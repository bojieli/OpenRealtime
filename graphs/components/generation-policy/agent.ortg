// A model activation policy is an ordinary graph element. It joins a
// successful observation commit with the exact trajectory State envelope that
// contains it, then emits a context-bound cognition trigger. Instantiate this
// component once per independently wired fast, deliberative, or specialist
// model; routing between those models remains outside the policy.
graph generation_policy {
    policy.GenerateOnObservation :: activation;

    input context = activation.context;
    input committed = activation.committed;
    input cancel = activation.cancel;

    output trigger = activation.trigger;
    output state = activation.state;
    output outcome = activation.outcome;
}
