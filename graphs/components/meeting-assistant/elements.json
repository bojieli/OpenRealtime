      "reaction": {
        "triggers": [
          "video"
        ],
        "outcomes": [
          "end",
          "foreground",
          "frame",
          "source",
          "tick"
        ],
        "max_concurrency": 1
      },
      "state_schema": "schema://openrealtime/meeting/screen-fork-state/v1",
      "config_schema": "schema://openrealtime/meeting/screen-fork-config/v1"
