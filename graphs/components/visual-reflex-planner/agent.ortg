// Audio-free multi-planner computer-use reference. A fast visual reflex and a
// slower planner sample the same canonical observation prefix independently.
// Each lane derives and admits its own exact proposal provenance; the explicit
// action arbiter selects the first complete admitted action per observation,
// cancels every losing cognition run, and exposes only the winner to the shared
// authority, ledger, dispatch, result-commit, and visual-feedback path.
graph visual_reflex_planner {
    state.ObservationCommit :: observation_commit;
    state.TrajectoryStore :: trajectory;
    policy.GenerateOnObservation :: reflex_activation;
    policy.GenerateOnObservation :: planner_activation;
    cognition.TextModel :: reflex_model;
    cognition.TextModel :: planner_model;
    interaction.ControlSerializationQuarantine :: reflex_control_quarantine;
    interaction.ControlSerializationQuarantine :: planner_control_quarantine;
    interaction.ModelResultCommit :: model_result_commit;
    authority.ProvenanceJoin :: reflex_provenance;
    authority.ProvenanceJoin :: planner_provenance;
    authority.ProposalAdmission :: reflex_admission;
    authority.ProposalAdmission :: planner_admission;
    authority.ActionArbiter :: action_arbiter;
    action.ToolLookup :: tool_lookup;
    authority.Confirmation :: confirmation;
    authority.TargetFence :: target_fence;
    action.AuthorizedCallCommit :: canonical_call_commit;
    action.LedgerCommit :: ledger_commit;
    action.Dispatch :: dispatch;
    action.ToolResultCommit :: tool_result_commit;
    flow.Mux :: trajectory_append_mux;
    flow.Mux :: model_result_mux;
    flow.Mux :: model_cancel_mux;
    flow.Tee :: trajectory_snapshot_copy;
    flow.Tee :: trajectory_committed_copy;
    flow.Tee :: trajectory_rejected_copy;
    flow.Tee :: observation_outcome_copy;
    flow.Tee :: reflex_candidate_copy;
    flow.Tee :: planner_candidate_copy;
    flow.Tee :: reflex_result_copy;
    flow.Tee :: planner_result_copy;
    flow.Tee :: reflex_proposal_copy;
    flow.Tee :: planner_proposal_copy;
    flow.Tee :: reflex_provenance_copy;
    flow.Tee :: planner_provenance_copy;
    flow.Tee :: selected_action_copy;
    flow.Tee :: arbitration_cancel_copy;
    flow.Tee :: model_cancel_copy;
    flow.Tee :: activation_cancel_copy;
    flow.Tee :: dispatch_result_copy;
    flow.Tee :: action_cancel_copy;
    flow.Tee :: action_timeout_copy;

    observation_commit.append -> trajectory_append_mux.in;
    model_result_commit.append -> trajectory_append_mux.in;
    canonical_call_commit.append -> trajectory_append_mux.in;
    tool_result_commit.append -> trajectory_append_mux.in;
    trajectory_append_mux.out -> trajectory.append;
    trajectory.snapshot -> trajectory_snapshot_copy.in;
    trajectory_snapshot_copy.out -> reflex_model.context;
    trajectory_snapshot_copy.out -> planner_model.context;
    trajectory_snapshot_copy.out -> canonical_call_commit.context;
    trajectory_snapshot_copy.out -> tool_result_commit.context;
    trajectory.committed -> trajectory_committed_copy.in;
    trajectory_committed_copy.out -> observation_commit.committed;
    trajectory_committed_copy.out -> model_result_commit.committed;
    trajectory_committed_copy.out -> canonical_call_commit.committed;
    trajectory_committed_copy.out -> tool_result_commit.committed;
    trajectory.rejected -> trajectory_rejected_copy.in;
    trajectory_rejected_copy.out -> observation_commit.rejected;
    trajectory_rejected_copy.out -> model_result_commit.rejected;
    trajectory_rejected_copy.out -> canonical_call_commit.rejected;
    trajectory_rejected_copy.out -> tool_result_commit.rejected;

    observation_commit.outcome -> observation_outcome_copy.in;
    observation_outcome_copy.out -> reflex_activation.committed;
    observation_outcome_copy.out -> planner_activation.committed;
    reflex_activation.trigger -> reflex_model.trigger;
    planner_activation.trigger -> planner_model.trigger;
    reflex_activation.authority -> reflex_candidate_copy.in;
    planner_activation.authority -> planner_candidate_copy.in;
    reflex_candidate_copy.out -> reflex_provenance.candidate;
    reflex_candidate_copy.out -> action_arbiter.candidate;
    planner_candidate_copy.out -> planner_provenance.candidate;
    planner_candidate_copy.out -> action_arbiter.candidate;

    reflex_model.text -> reflex_control_quarantine.text;
    reflex_model.result -> reflex_control_quarantine.result;
    planner_model.text -> planner_control_quarantine.text;
    planner_model.result -> planner_control_quarantine.result;
    reflex_control_quarantine.safe_result -> reflex_result_copy.in;
    planner_control_quarantine.safe_result -> planner_result_copy.in;
    reflex_result_copy.out -> model_result_mux.in;
    planner_result_copy.out -> model_result_mux.in;
    model_result_mux.out -> model_result_commit.result;
    reflex_result_copy.out -> reflex_provenance.result;
    reflex_result_copy.out -> action_arbiter.result;
    planner_result_copy.out -> planner_provenance.result;
    planner_result_copy.out -> action_arbiter.result;
    reflex_model.tools -> reflex_proposal_copy.in;
    planner_model.tools -> planner_proposal_copy.in;
    reflex_proposal_copy.out -> reflex_provenance.proposal;
    reflex_proposal_copy.out -> reflex_admission.proposal;
    planner_proposal_copy.out -> planner_provenance.proposal;
    planner_proposal_copy.out -> planner_admission.proposal;
    reflex_provenance.provenance -> reflex_provenance_copy.in;
    planner_provenance.provenance -> planner_provenance_copy.in;
    reflex_provenance_copy.out -> reflex_admission.provenance;
    planner_provenance_copy.out -> planner_admission.provenance;
    reflex_admission.admitted -> action_arbiter.proposal;
    planner_admission.admitted -> action_arbiter.proposal;
    action_arbiter.selected -> selected_action_copy.in;
    selected_action_copy.out -> tool_lookup.proposal;

    action_arbiter.cancel_upstream -> arbitration_cancel_copy.in;
    arbitration_cancel_copy.out -> model_cancel_mux.in;
    model_cancel_mux.out -> model_cancel_copy.in;
    model_cancel_copy.out -> reflex_model.cancel;
    model_cancel_copy.out -> planner_model.cancel;
    activation_cancel_copy.out -> reflex_activation.cancel;
    activation_cancel_copy.out -> planner_activation.cancel;

    tool_lookup.declared -> confirmation.action;
    confirmation.confirmed -> target_fence.action;
    target_fence.authorized -> canonical_call_commit.action;
    canonical_call_commit.canonical -> ledger_commit.action;
    ledger_commit.executable -> dispatch.execute;
    dispatch.result -> dispatch_result_copy.in;
    dispatch_result_copy.out -> tool_result_commit.result;

    action_cancel_copy.out -> reflex_provenance.cancel;
    action_cancel_copy.out -> planner_provenance.cancel;
    action_cancel_copy.out -> reflex_admission.cancel;
    action_cancel_copy.out -> planner_admission.cancel;
    action_cancel_copy.out -> confirmation.cancel;
    action_cancel_copy.out -> canonical_call_commit.cancel;
    action_cancel_copy.out -> ledger_commit.cancel;
    action_cancel_copy.out -> dispatch.cancel;
    action_cancel_copy.out -> tool_result_commit.cancel;
    action_timeout_copy.out -> reflex_provenance.timeout;
    action_timeout_copy.out -> planner_provenance.timeout;
    action_timeout_copy.out -> reflex_admission.timeout;
    action_timeout_copy.out -> planner_admission.timeout;
    action_timeout_copy.out -> confirmation.timeout;
    action_timeout_copy.out -> canonical_call_commit.timeout;
    action_timeout_copy.out -> ledger_commit.timeout;
    action_timeout_copy.out -> dispatch.timeout;
    action_timeout_copy.out -> tool_result_commit.timeout;

    input observations = observation_commit.observations;
    input activation_cancel = activation_cancel_copy.in;
    input model_cancel = model_cancel_mux.in;
    input action_cancel = action_cancel_copy.in;
    input action_timeout = action_timeout_copy.in;
    output trajectory_snapshot = trajectory_snapshot_copy.out;
    output trajectory_commit = trajectory_committed_copy.out;
    output trajectory_rejection = trajectory_rejected_copy.out;
    output observation_outcome = observation_outcome_copy.out;
    output reflex_activation_state = reflex_activation.state;
    output reflex_activation_outcome = reflex_activation.outcome;
    output planner_activation_state = planner_activation.state;
    output planner_activation_outcome = planner_activation.outcome;
    output reflex_text = reflex_control_quarantine.safe_text;
    output planner_text = planner_control_quarantine.safe_text;
    output reflex_result = reflex_result_copy.out;
    output planner_result = planner_result_copy.out;
    output reflex_control_serialization_quarantine = reflex_control_quarantine.quarantined;
    output planner_control_serialization_quarantine = planner_control_quarantine.quarantined;
    output reflex_proposals = reflex_proposal_copy.out;
    output planner_proposals = planner_proposal_copy.out;
    output reflex_model_outcome = reflex_model.outcome;
    output planner_model_outcome = planner_model.outcome;
    output reflex_model_resolution = reflex_model.resolved;
    output planner_model_resolution = planner_model.resolved;
    output model_commit_outcome = model_result_commit.outcome;
    output reflex_provenance_audit = reflex_provenance_copy.out;
    output planner_provenance_audit = planner_provenance_copy.out;
    output reflex_provenance_outcome = reflex_provenance.outcome;
    output planner_provenance_outcome = planner_provenance.outcome;
    output reflex_provenance_resolution = reflex_provenance.resolved;
    output planner_provenance_resolution = planner_provenance.resolved;
    output reflex_admission_outcome = reflex_admission.outcome;
    output planner_admission_outcome = planner_admission.outcome;
    output reflex_admission_resolution = reflex_admission.resolved;
    output planner_admission_resolution = planner_admission.resolved;
    output selected_action = selected_action_copy.out;
    output arbitration_model_cancel = arbitration_cancel_copy.out;
    output arbitration_outcome = action_arbiter.outcome;
    output arbitration_resolution = action_arbiter.resolved;
    output lookup_outcome = tool_lookup.outcome;
    output lookup_resolution = tool_lookup.resolved;
    output confirmation_outcome = confirmation.outcome;
    output confirmation_resolution = confirmation.resolved;
    output target_fence_outcome = target_fence.outcome;
    output target_fence_resolution = target_fence.resolved;
    output canonical_call_outcome = canonical_call_commit.outcome;
    output canonical_call_resolution = canonical_call_commit.resolved;
    output ledger_transition = ledger_commit.transition;
    output ledger_outcome = ledger_commit.outcome;
    output ledger_resolution = ledger_commit.resolved;
    output dispatch_commit = dispatch.committed;
    output dispatch_result = dispatch_result_copy.out;
    output dispatch_transition = dispatch.transition;
    output dispatch_audit = dispatch.audit;
    output dispatch_outcome = dispatch.outcome;
    output dispatch_resolution = dispatch.resolved;
    output canonical_result = tool_result_commit.canonical;
    output result_commit_outcome = tool_result_commit.outcome;
    output result_commit_resolution = tool_result_commit.resolved;
}
