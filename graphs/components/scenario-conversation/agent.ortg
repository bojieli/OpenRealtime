    invocation_update_copy.out -> silent_session_invocation.update;
    generation_cancel_copy.out -> semantic_admission.cancel;
    generation_cancel_copy.out -> voice_session_invocation.cancel;
    generation_cancel_copy.out -> silent_session_invocation.cancel;
    semantic_admission.voice_committed -> voice_session_invocation.committed;
    semantic_admission.silent_committed -> silent_session_invocation.committed;
    semantic_admission.voice_create -> voice_session_invocation.create;
    semantic_admission.silent_create -> silent_session_invocation.create;
    semantic_admission.decision -> semantic_decision_copy.in;
    semantic_decision_copy.out -> overlap_barge_in.semantic;
    semantic_admission.silent_cancel -> model_cancel_mux.in;
    overlap_barge_in.agent_output -> semantic_admission.agent_output;
    voice_session_invocation.trigger -> voice_model.trigger;
    silent_session_invocation.trigger -> silent_model.trigger;
    voice_session_invocation.authority -> invocation_authority_mux.in;
    silent_session_invocation.authority -> invocation_authority_mux.in;
    invocation_authority_mux.out -> provenance_join.candidate;
    voice_session_invocation.state -> invocation_state_mux.in;
    silent_session_invocation.state -> invocation_state_mux.in;
    voice_session_invocation.outcome -> voice_invocation_outcome_copy.in;
    voice_invocation_outcome_copy.out -> invocation_outcome_mux.in;
    voice_invocation_outcome_copy.out -> overlap_barge_in.invocation;
    silent_session_invocation.outcome -> invocation_outcome_mux.in;
    voice_model.text -> control_quarantine.text;
    control_quarantine.safe_text -> model_text_copy.in;
    silent_model.text -> silent_control_quarantine.text;
    silent_control_quarantine.safe_text -> silent_model_text_drop.in;
    model_text_copy.out -> segment.text;
    voice_model.result -> control_quarantine.result;
    silent_model.result -> silent_control_quarantine.result;
    control_quarantine.safe_result -> overlap_barge_in.result;
    overlap_barge_in.safe_result -> model_result_mux.in;
    silent_control_quarantine.safe_result -> model_result_mux.in;
    model_result_mux.out -> model_result_copy.in;
    control_quarantine.quarantined -> control_quarantine_audit_mux.in;
    silent_control_quarantine.quarantined -> control_quarantine_audit_mux.in;
    model_result_copy.out -> model_result_commit.result;
    model_result_copy.out -> provenance_join.result;
    voice_model.tools -> model_proposal_mux.in;
    silent_model.tools -> model_proposal_mux.in;
    model_proposal_mux.out -> model_proposal_copy.in;
    model_proposal_copy.out -> provenance_join.proposal;
    model_proposal_copy.out -> proposal_admission.proposal;
