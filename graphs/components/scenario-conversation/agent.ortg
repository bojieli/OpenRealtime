    retention.fetched -> media_resolver.fetched;
    media_resolver.store_cancel -> retention.cancel;
    media_resolver.return_lease -> retention.return_lease;
    content.observations -> content_observation_copy.in;
    content_observation_copy.out -> message_observation_commit.observations;
    content_observation_copy.out -> observation_output_mux.in;
    audio_observation_commit.append -> trajectory_append_mux.in;
    message_observation_commit.append -> trajectory_append_mux.in;
    model_result_commit.append -> trajectory_append_mux.in;
    canonical_call_commit.append -> trajectory_append_mux.in;
    tool_result_commit.append -> trajectory_append_mux.in;
    trajectory_append_mux.out -> trajectory.append;
    trajectory.snapshot -> trajectory_snapshot_copy.in;
    trajectory_snapshot_copy.out -> semantic_admission.context;
    trajectory_snapshot_copy.out -> voice_model.context;
    trajectory_snapshot_copy.out -> silent_model.context;
    trajectory_snapshot_copy.out -> canonical_call_commit.context;
    trajectory_snapshot_copy.out -> tool_result_commit.context;
    trajectory_snapshot_copy.out -> post_commit_silence.context;
