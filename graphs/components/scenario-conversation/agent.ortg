// Fine-grained graph-native OpenAI Realtime conversation profile. Provider,
// action, retention, and playback implementations are selected by the launch
// application; this component contains no server or presentation switch.
graph scenario_conversation {
    acoustic.EnergyAdmission :: admission;
    acoustic.EndpointPolicy :: endpoint_policy;
    perception.ASR :: asr;
    perception.FinalObservationGate :: audio_final_gate;
    ingress.UserContent :: content;
    media.RetainedMedia :: retention;
    media.ResolveAttachment :: media_resolver;
    state.ObservationCommit :: audio_observation_commit;
    state.ObservationCommit :: message_observation_commit;
    state.TrajectoryStore :: trajectory;
    policy.SemanticAdmission :: semantic_admission;
    policy.SessionInvocation :: voice_session_invocation;
    policy.SessionInvocation :: silent_session_invocation;
    interaction.PostCommitSilence :: post_commit_silence;
    interaction.OverlapBargeIn :: overlap_barge_in;
    cognition.TextModel :: voice_model;
    cognition.TextModel :: silent_model;
    interaction.ControlSerializationQuarantine :: control_quarantine;
    interaction.ControlSerializationQuarantine :: silent_control_quarantine;
    interaction.ModelResultCommit :: model_result_commit;
    interaction.SegmentPreparedText :: segment;
    authority.ProvenanceJoin :: provenance_join;
    authority.ProposalAdmission :: proposal_admission;
    action.ToolLookup :: tool_lookup;
    action.NormalizeArguments :: normalize_arguments;
    authority.Confirmation :: confirmation;
    authority.TargetFence :: target_fence;
    action.AuthorizedCallCommit :: canonical_call_commit;
    action.ClientToolResultIngress :: client_tool_result;
    action.ClientToolResultJoin :: client_tool_result_join;
    action.LedgerCommit :: ledger_commit;
    action.Dispatch :: dispatch;
    action.ToolResultCommit :: tool_result_commit;
    speech.TTS :: tts;
    speech.Playback :: playback;
    flow.Tee :: acoustic_activity_copy;
    flow.Tee :: endpoint_state_copy;
    flow.Tee :: endpoint_candidate_copy;
    flow.Tee :: endpoint_command_copy;
    flow.Tee :: audio_cancel_copy;
    flow.Tee :: asr_observation_copy;
    flow.Tee :: asr_outcome_copy;
    flow.Tee :: content_observation_copy;
    flow.Tee :: message_commit_outcome_copy;
    flow.Tee :: semantic_decision_copy;
    flow.Mux :: observation_output_mux;
    flow.Mux :: trajectory_append_mux;
    flow.Tee :: trajectory_snapshot_copy;
    flow.Tee :: trajectory_committed_copy;
    flow.Tee :: trajectory_rejected_copy;
    flow.Tee :: audio_commit_outcome_copy;
    flow.Tee :: invocation_update_copy;
    flow.Tee :: voice_invocation_outcome_copy;
    flow.Tee :: generation_cancel_copy;
    flow.Mux :: model_cancel_mux;
    flow.Tee :: model_cancel_copy;
    flow.Tee :: model_text_copy;
    flow.Drop :: silent_model_text_drop;
    flow.Mux :: model_result_mux;
    flow.Tee :: model_result_copy;
    flow.Mux :: control_quarantine_audit_mux;
    flow.Mux :: model_proposal_mux;
    flow.Tee :: model_proposal_copy;
    flow.Mux :: model_outcome_mux;
    flow.Tee :: voice_model_outcome_copy;
    flow.Tee :: model_outcome_copy;
    flow.Mux :: invocation_state_mux;
    flow.Mux :: invocation_outcome_mux;
    flow.Mux :: invocation_authority_mux;
    flow.Tee :: provenance_copy;
    flow.Tee :: dispatch_result_copy;
    flow.Tee :: action_cancel_copy;
    flow.Tee :: action_timeout_copy;
    flow.Tee :: segment_model_cancel_copy;
    flow.Tee :: speech_cancel_copy;
    flow.Tee :: prepared_speech_copy;
    flow.Mux :: segmentation_cancel_mux;
    flow.Mux :: tts_cancel_mux;
    flow.Mux :: playback_cancel_mux;
    flow.Tee :: segmentation_outcome_copy;
    flow.Tee :: tts_status_copy;
    flow.Tee :: playback_status_copy;
    endpoint_policy.state -> endpoint_state_copy.in;
    endpoint_state_copy.out -> admission.policy;
    admission.candidate -> endpoint_candidate_copy.in;
    endpoint_candidate_copy.out -> endpoint_policy.candidate;
    endpoint_policy.command -> endpoint_command_copy.in;
    endpoint_command_copy.out -> admission.command;
    audio_cancel_copy.out -> admission.cancel;
    audio_cancel_copy.out -> endpoint_policy.cancel;
    audio_cancel_copy.out -> asr.cancel;
    admission.activity -> acoustic_activity_copy.in;
    acoustic_activity_copy.out -> overlap_barge_in.activity;
    admission.admitted -> asr.observe;
    admission.endpoint -> asr.flush;
    asr.observations -> asr_observation_copy.in;
    asr_observation_copy.out -> audio_final_gate.observations;
    asr_observation_copy.out -> observation_output_mux.in;
