// Graph-native session form of the Realtime-CU agent. Protocol audio, video,
// and typed user messages are converted by the selected session adapter into
// typed observations and enter through separate, inspectable boundary lanes.
// The graph owns observation commit, cognition, authority, dispatch, result
// commit, and the visual-consequence feedback trajectory. Client execution is
// a deployment-selected dispatcher; the adapter only renders the committed
// call and returns the client's result to that dispatcher.
graph realtime_computer_use {
    flow.Mux :: observation_ingress;
    flow.Tee :: observation_input_copy;
    state.RealtimeComputerUseObservationCommit :: observation_commit;
    state.TrajectoryStore :: trajectory;
    policy.TemporalEvidenceAdmission :: temporal_evidence_admission;
    policy.IntentSettlement :: settlement;
    policy.IntentDispositionRetry :: settlement_retry;
    policy.IntentDispositionProducer :: settlement_producer;
    policy.RealtimeComputerUseActivation :: activation;
    policy.RealtimeComputerUseCancellationCoordinator :: cancellation_coordinator;
    cognition.TextModel :: model;
    interaction.ControlSerializationQuarantine :: model_control_quarantine;
    interaction.ModelResultCommit :: model_result_commit;
    authority.ProvenanceJoin :: provenance_join;
    authority.ProposalAdmission :: proposal_admission;
    action.ToolLookup :: tool_lookup;
    action.NormalizeArguments :: normalize_arguments;
    action.ToolAdmission :: tool_admission;
    action.RepetitionAdmission :: repetition_admission;
    authority.Confirmation :: confirmation;
    authority.TargetFence :: target_fence;
    action.AuthorizedCallCommit :: canonical_call_commit;
    action.LedgerCommit :: ledger_commit;
    action.Dispatch :: dispatch;
    action.ToolResultCommit :: tool_result_commit;
    flow.Mux :: trajectory_append_mux;
    flow.Tee :: trajectory_snapshot_copy;
    flow.Tee :: trajectory_committed_copy;
    flow.Tee :: trajectory_rejected_copy;
    flow.Tee :: observation_outcome_copy;
    flow.Tee :: model_result_copy;
    flow.Tee :: model_proposal_copy;
    flow.Tee :: provenance_copy;
    flow.Tee :: dispatch_result_copy;
    flow.Tee :: action_cancel_copy;
    flow.Tee :: action_timeout_copy;
    flow.Tee :: settlement_cancel_copy;
    flow.Tee :: settlement_disposition_copy;
    flow.Tee :: settlement_outcome_copy;
    flow.Tee :: settlement_producer_outcome_copy;
    flow.Tee :: activation_outcome_copy;
    flow.Tee :: model_outcome_copy;
    flow.Tee :: model_commit_outcome_copy;
    flow.Tee :: provenance_outcome_copy;
    flow.Tee :: admission_outcome_copy;
    flow.Tee :: confirmation_outcome_copy;
    flow.Tee :: canonical_call_outcome_copy;
    flow.Tee :: ledger_outcome_copy;
    flow.Tee :: dispatch_outcome_copy;
    flow.Tee :: result_commit_outcome_copy;
    flow.Mux :: action_outcome_mux;
    flow.Mux :: effect_terminal_mux;
    flow.Drop :: settlement_retry_exhausted_sink;
    observation_ingress.out -> observation_input_copy.in;
    observation_input_copy.out -> observation_commit.observations;
    observation_commit.append -> trajectory_append_mux.in;
    model_result_commit.append -> trajectory_append_mux.in;
    canonical_call_commit.append -> trajectory_append_mux.in;
    tool_result_commit.append -> trajectory_append_mux.in;
    activation.disposition_append -> trajectory_append_mux.in;
    trajectory_append_mux.out -> trajectory.append;
    trajectory.snapshot -> trajectory_snapshot_copy.in;
    trajectory_snapshot_copy.out -> model.context;
    trajectory_snapshot_copy.out -> canonical_call_commit.context;
    trajectory_snapshot_copy.out -> tool_result_commit.context;
    trajectory.committed -> trajectory_committed_copy.in;
    trajectory_committed_copy.out -> observation_commit.committed;
    trajectory_committed_copy.out -> model_result_commit.committed;
    trajectory_committed_copy.out -> canonical_call_commit.committed;
    trajectory_committed_copy.out -> tool_result_commit.committed;
    trajectory_committed_copy.out -> activation.disposition_committed;
    trajectory.rejected -> trajectory_rejected_copy.in;
    trajectory_rejected_copy.out -> observation_commit.rejected;
    trajectory_rejected_copy.out -> model_result_commit.rejected;
    trajectory_rejected_copy.out -> canonical_call_commit.rejected;
    trajectory_rejected_copy.out -> tool_result_commit.rejected;
    trajectory_rejected_copy.out -> activation.disposition_rejected;
    observation_commit.outcome -> observation_outcome_copy.in;
    observation_outcome_copy.out -> temporal_evidence_admission.committed;
    temporal_evidence_admission.admitted -> settlement.evidence;
    settlement.probe -> settlement_retry.probe;
    settlement_retry.attempt -> settlement_producer.probe;
    settlement_producer.disposition -> settlement_disposition_copy.in;
    settlement_disposition_copy.out -> settlement.disposition;
    settlement_disposition_copy.out -> settlement_retry.disposition;
    settlement_retry.exhausted -> settlement_retry_exhausted_sink.in;
    settlement_retry.forwarded_reset -> settlement.reset;
    settlement.admitted -> activation.admitted;
    settlement.cleanup -> activation.effect_cleanup;
    settlement.terminal -> activation.settlement;
    activation.settlement_ack -> settlement.ack;
    activation.trigger -> model.trigger;
    activation.authority -> provenance_join.candidate;
    model.text -> model_control_quarantine.text;
    model.result -> model_control_quarantine.result;
    model_control_quarantine.safe_result -> model_result_copy.in;
    model_result_copy.out -> activation.result;
    model_result_copy.out -> model_result_commit.result;
    model_result_copy.out -> provenance_join.result;
    model.tools -> model_proposal_copy.in;
    model_proposal_copy.out -> provenance_join.proposal;
    model_proposal_copy.out -> proposal_admission.proposal;
    provenance_join.provenance -> provenance_copy.in;
    provenance_copy.out -> proposal_admission.provenance;
    proposal_admission.admitted -> tool_lookup.proposal;
    tool_lookup.declared -> normalize_arguments.action;
    normalize_arguments.normalized -> tool_admission.action;
    tool_admission.admitted -> repetition_admission.action;
    repetition_admission.admitted -> confirmation.action;
    confirmation.confirmed -> target_fence.action;
    target_fence.authorized -> canonical_call_commit.action;
    canonical_call_commit.canonical -> ledger_commit.action;
    ledger_commit.executable -> dispatch.execute;
    dispatch.result -> dispatch_result_copy.in;
    dispatch_result_copy.out -> tool_result_commit.result;
    tool_result_commit.canonical -> repetition_admission.result;
    tool_admission.terminal -> effect_terminal_mux.in;
    repetition_admission.terminal -> effect_terminal_mux.in;
    effect_terminal_mux.out -> activation.effect_terminal;
    cancellation_coordinator.settlement_cancel -> settlement_retry.cancel;
    settlement_retry.forwarded_cancel -> settlement_cancel_copy.in;
    settlement_cancel_copy.out -> settlement.cancel;
    settlement_cancel_copy.out -> settlement_producer.cancel;
    cancellation_coordinator.activation_cancel -> activation.cancel;
    cancellation_coordinator.model_cancel -> model.cancel;
    cancellation_coordinator.action_cancel -> action_cancel_copy.in;
    activation.outcome -> activation_outcome_copy.in;
    activation_outcome_copy.out -> cancellation_coordinator.activation_outcome;
    model.outcome -> model_outcome_copy.in;
    model_outcome_copy.out -> cancellation_coordinator.model_outcome;
    model_result_commit.outcome -> model_commit_outcome_copy.in;
    model_commit_outcome_copy.out -> cancellation_coordinator.model_commit_outcome;
    settlement.outcome -> settlement_outcome_copy.in;
    settlement_outcome_copy.out -> cancellation_coordinator.settlement_outcome;
    settlement_producer.outcome -> settlement_producer_outcome_copy.in;
    settlement_producer_outcome_copy.out -> cancellation_coordinator.settlement_producer_outcome;
    provenance_join.outcome -> provenance_outcome_copy.in;
    proposal_admission.outcome -> admission_outcome_copy.in;
    confirmation.outcome -> confirmation_outcome_copy.in;
    canonical_call_commit.outcome -> canonical_call_outcome_copy.in;
    ledger_commit.outcome -> ledger_outcome_copy.in;
    dispatch.outcome -> dispatch_outcome_copy.in;
    tool_result_commit.outcome -> result_commit_outcome_copy.in;
    provenance_outcome_copy.out -> action_outcome_mux.in;
    admission_outcome_copy.out -> action_outcome_mux.in;
    confirmation_outcome_copy.out -> action_outcome_mux.in;
    canonical_call_outcome_copy.out -> action_outcome_mux.in;
    ledger_outcome_copy.out -> action_outcome_mux.in;
    dispatch_outcome_copy.out -> action_outcome_mux.in;
    result_commit_outcome_copy.out -> action_outcome_mux.in;
    action_outcome_mux.out -> cancellation_coordinator.action_outcome;
    action_cancel_copy.out -> provenance_join.cancel;
    action_cancel_copy.out -> proposal_admission.cancel;
    action_cancel_copy.out -> confirmation.cancel;
    action_cancel_copy.out -> canonical_call_commit.cancel;
    action_cancel_copy.out -> ledger_commit.cancel;
    action_cancel_copy.out -> dispatch.cancel;
    action_cancel_copy.out -> tool_result_commit.cancel;
    action_timeout_copy.out -> provenance_join.timeout;
    action_timeout_copy.out -> proposal_admission.timeout;
    action_timeout_copy.out -> confirmation.timeout;
    action_timeout_copy.out -> canonical_call_commit.timeout;
    action_timeout_copy.out -> ledger_commit.timeout;
    action_timeout_copy.out -> dispatch.timeout;
    action_timeout_copy.out -> tool_result_commit.timeout;
    input audio = observation_ingress.in;
    input video = observation_ingress.in;
    input text = observation_ingress.in;
    input session_cancel = cancellation_coordinator.request;
    input settlement_reset = settlement_retry.reset;
    input action_timeout = action_timeout_copy.in;
    output observation_events = observation_input_copy.out;
    output transcript_events = observation_input_copy.out;
    output trajectory_snapshot = trajectory_snapshot_copy.out;
    output trajectory_commit = trajectory_committed_copy.out;
    output trajectory_rejection = trajectory_rejected_copy.out;
    output observation_outcome = observation_outcome_copy.out;
    output temporal_evidence_admission_outcome = temporal_evidence_admission.outcome;
    output settlement_state = settlement.state;
    output settlement_outcome = settlement_outcome_copy.out;
    output settlement_producer_state = settlement_producer.state;
    output settlement_producer_outcome = settlement_producer_outcome_copy.out;
    output settlement_producer_resolution = settlement_producer.resolved;
    output settlement_retry_state = settlement_retry.state;
    output settlement_retry_outcome = settlement_retry.outcome;
    output cancellation_state = cancellation_coordinator.state;
    output cancellation_outcome = cancellation_coordinator.outcome;
    output activation_state = activation.state;
    output activation_outcome = activation_outcome_copy.out;
    output prepared_text = model_control_quarantine.safe_text;
    output model_result = model_result_copy.out;
    output control_serialization_quarantine = model_control_quarantine.quarantined;
    output model_proposals = model_proposal_copy.out;
    output model_outcome = model_outcome_copy.out;
    output model_resolution = model.resolved;
    output model_commit_outcome = model_commit_outcome_copy.out;
    output provenance_audit = provenance_copy.out;
    output provenance_outcome = provenance_outcome_copy.out;
    output provenance_resolution = provenance_join.resolved;
    output admission_outcome = admission_outcome_copy.out;
    output admission_resolution = proposal_admission.resolved;
    output lookup_outcome = tool_lookup.outcome;
    output lookup_resolution = tool_lookup.resolved;
    output argument_normalization_outcome = normalize_arguments.outcome;
    output argument_normalization_resolution = normalize_arguments.resolved;
    output tool_admission_outcome = tool_admission.outcome;
    output tool_admission_resolution = tool_admission.resolved;
    output repetition_admission_outcome = repetition_admission.outcome;
    output repetition_admission_resolution = repetition_admission.resolved;
    output confirmation_outcome = confirmation_outcome_copy.out;
    output confirmation_resolution = confirmation.resolved;
    output target_fence_outcome = target_fence.outcome;
    output target_fence_resolution = target_fence.resolved;
    output canonical_call_outcome = canonical_call_outcome_copy.out;
    output canonical_call_resolution = canonical_call_commit.resolved;
    output ledger_transition = ledger_commit.transition;
    output ledger_outcome = ledger_outcome_copy.out;
    output ledger_resolution = ledger_commit.resolved;
    output dispatch_commit = dispatch.committed;
    output dispatch_result = dispatch_result_copy.out;
    output dispatch_transition = dispatch.transition;
    output dispatch_audit = dispatch.audit;
    output dispatch_outcome = dispatch_outcome_copy.out;
    output dispatch_resolution = dispatch.resolved;
    output canonical_result = repetition_admission.canonical_result;
    output result_commit_outcome = result_commit_outcome_copy.out;
    output result_commit_resolution = tool_result_commit.resolved;
}
