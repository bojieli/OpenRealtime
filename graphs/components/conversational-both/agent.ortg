// Complete componentized conversational agent. Fast and deliberative models
// observe and commit independently, and both may speak only through the
// explicit stream-aware arbiter. No edge connects one model to the other.
graph conversational_both {
    acoustic.EnergyAdmission :: admission;
    acoustic.EndpointPolicy :: endpoint_policy;
    perception.ASR :: asr;
    state.ObservationCommit :: observation_commit;
    state.TrajectoryStore :: trajectory;
    policy.GenerateOnObservation :: fast_activation;
    policy.GenerateOnObservation :: slow_activation;
    cognition.TextModel :: fast_model;
    cognition.TextModel :: slow_model;
    interaction.ControlSerializationQuarantine :: fast_control_quarantine;
    interaction.ControlSerializationQuarantine :: slow_control_quarantine;
    authority.ProvenanceJoin :: fast_action_join;
    authority.ProvenanceJoin :: slow_action_join;
    interaction.ModelResultCommit :: fast_result_commit;
    interaction.ModelResultCommit :: slow_result_commit;
    interaction.SpeechArbiter :: arbiter;
    interaction.SegmentPreparedText :: segment;
    speech.TTS :: tts;
    speech.Playback :: playback;
    flow.Tee :: endpoint_state_copy;
    flow.Tee :: endpoint_candidate_copy;
    flow.Tee :: endpoint_command_copy;
    flow.Tee :: audio_cancel_copy;
    flow.Mux :: append_mux;
    flow.Tee :: committed_copy;
    flow.Tee :: rejected_copy;
    flow.Tee :: snapshot_copy;
    flow.Tee :: observation_outcome_copy;
    flow.Tee :: fast_text_copy;
    flow.Tee :: slow_text_copy;
    flow.Tee :: fast_result_copy;
    flow.Tee :: slow_result_copy;
    flow.Tee :: fast_tool_copy;
    flow.Tee :: slow_tool_copy;
    flow.Tee :: fast_outcome_copy;
    flow.Tee :: slow_outcome_copy;
    flow.Tee :: speech_cancel_copy;
    flow.Mux :: tts_cancel_mux;
    flow.Mux :: playback_cancel_mux;
    endpoint_policy.state -> endpoint_state_copy.in;
    endpoint_state_copy.out -> admission.policy;
    admission.candidate -> endpoint_candidate_copy.in;
    endpoint_candidate_copy.out -> endpoint_policy.candidate;
    endpoint_policy.command -> endpoint_command_copy.in;
    endpoint_command_copy.out -> admission.command;
    audio_cancel_copy.out -> admission.cancel;
    audio_cancel_copy.out -> endpoint_policy.cancel;
    audio_cancel_copy.out -> asr.cancel;
    admission.admitted -> asr.observe;
    admission.endpoint -> asr.flush;
    asr.observations -> observation_commit.observations;
    observation_commit.append -> append_mux.in;
    fast_result_commit.append -> append_mux.in;
    slow_result_commit.append -> append_mux.in;
    append_mux.out -> trajectory.append;
    trajectory.committed -> committed_copy.in;
    committed_copy.out -> observation_commit.committed;
    committed_copy.out -> fast_result_commit.committed;
    committed_copy.out -> slow_result_commit.committed;
    trajectory.rejected -> rejected_copy.in;
    rejected_copy.out -> observation_commit.rejected;
    rejected_copy.out -> fast_result_commit.rejected;
    rejected_copy.out -> slow_result_commit.rejected;
    trajectory.snapshot -> snapshot_copy.in;
    snapshot_copy.out -> fast_model.context;
    snapshot_copy.out -> slow_model.context;
    observation_commit.outcome -> observation_outcome_copy.in;
    observation_outcome_copy.out -> fast_activation.committed;
    observation_outcome_copy.out -> slow_activation.committed;
    fast_activation.trigger -> fast_model.trigger;
    slow_activation.trigger -> slow_model.trigger;
    fast_activation.authority -> fast_action_join.candidate;
    slow_activation.authority -> slow_action_join.candidate;
    fast_model.text -> fast_control_quarantine.text;
    fast_model.result -> fast_control_quarantine.result;
    slow_model.text -> slow_control_quarantine.text;
    slow_model.result -> slow_control_quarantine.result;
    fast_control_quarantine.safe_text -> fast_text_copy.in;
    slow_control_quarantine.safe_text -> slow_text_copy.in;
    fast_control_quarantine.safe_result -> fast_result_copy.in;
    slow_control_quarantine.safe_result -> slow_result_copy.in;
    fast_result_copy.out -> fast_result_commit.result;
    slow_result_copy.out -> slow_result_commit.result;
    fast_result_copy.out -> fast_action_join.result;
    slow_result_copy.out -> slow_action_join.result;
    fast_model.tools -> fast_tool_copy.in;
    slow_model.tools -> slow_tool_copy.in;
    fast_tool_copy.out -> fast_action_join.proposal;
    slow_tool_copy.out -> slow_action_join.proposal;
    fast_model.outcome -> fast_outcome_copy.in;
    slow_model.outcome -> slow_outcome_copy.in;
    // Both streams acquire speech authority only through explicit selection.
    fast_text_copy.out -> arbiter.text;
    slow_text_copy.out -> arbiter.text;
    fast_outcome_copy.out -> arbiter.terminal;
    slow_outcome_copy.out -> arbiter.terminal;
    arbiter.selected -> segment.text;
    fast_outcome_copy.out -> segment.terminal;
    slow_outcome_copy.out -> segment.terminal;
    segment.segments -> tts.text;
    segment.speech_cancel -> speech_cancel_copy.in;
    speech_cancel_copy.out -> tts_cancel_mux.in;
    speech_cancel_copy.out -> playback_cancel_mux.in;
    tts_cancel_mux.out -> tts.cancel;
    tts.audio -> playback.audio;
    playback_cancel_mux.out -> playback.cancel;
    input audio = admission.audio;
    input endpoint_tick = endpoint_policy.tick;
    input endpoint_commit = endpoint_policy.commit;
    input endpoint_verdict = endpoint_policy.verdict;
    input audio_cancel = audio_cancel_copy.in;
    input fast_activation_cancel = fast_activation.cancel;
    input slow_activation_cancel = slow_activation.cancel;
    input fast_model_cancel = fast_model.cancel;
    input slow_model_cancel = slow_model.cancel;
    input fast_action_cancel = fast_action_join.cancel;
    input slow_action_cancel = slow_action_join.cancel;
    input fast_action_timeout = fast_action_join.timeout;
    input slow_action_timeout = slow_action_join.timeout;
    input speech_selection = arbiter.selection;
    input arbitration_timeout = arbiter.timeout;
    input arbitration_cancel = arbiter.cancel;
    input segmentation_timeout = segment.timeout;
    input segmentation_cancel = segment.cancel;
    input tts_cancel = tts_cancel_mux.in;
    input playback_cancel = playback_cancel_mux.in;
    output endpoint_policy_state = endpoint_state_copy.out;
    output endpoint_candidate = endpoint_candidate_copy.out;
    output endpoint_command = endpoint_command_copy.out;
    output acoustic_activity = admission.activity;
    output admission_state = admission.state;
    output admission_outcome = admission.outcome;
    output endpoint_outcome = endpoint_policy.outcome;
    output audio_cancel_observed = audio_cancel_copy.out;
    output perception_outcome = asr.outcome;
    output asr_resolution = asr.resolved;
    output store_commit = committed_copy.out;
    output store_rejection = rejected_copy.out;
    output trajectory_snapshot = snapshot_copy.out;
    output observation_commit_outcome = observation_outcome_copy.out;
    output fast_activation_state = fast_activation.state;
    output fast_activation_outcome = fast_activation.outcome;
    output slow_activation_state = slow_activation.state;
    output slow_activation_outcome = slow_activation.outcome;
    output fast_prepared_text = fast_text_copy.out;
    output slow_prepared_text = slow_text_copy.out;
    output fast_result = fast_result_copy.out;
    output slow_result = slow_result_copy.out;
    output fast_control_serialization_quarantine = fast_control_quarantine.quarantined;
    output slow_control_serialization_quarantine = slow_control_quarantine.quarantined;
    output fast_tools = fast_tool_copy.out;
    output slow_tools = slow_tool_copy.out;
    // This component deliberately stops before action admission. Provenance is
    // retained at an explicit terminal audit boundary for an embedding graph.
    output fast_action_provenance_audit = fast_action_join.provenance;
    output slow_action_provenance_audit = slow_action_join.provenance;
    output fast_action_join_outcome = fast_action_join.outcome;
    output slow_action_join_outcome = slow_action_join.outcome;
    output fast_action_join_resolution = fast_action_join.resolved;
    output slow_action_join_resolution = slow_action_join.resolved;
    output fast_model_outcome = fast_outcome_copy.out;
    output slow_model_outcome = slow_outcome_copy.out;
    output fast_model_resolution = fast_model.resolved;
    output slow_model_resolution = slow_model.resolved;
    output fast_commit_outcome = fast_result_commit.outcome;
    output slow_commit_outcome = slow_result_commit.outcome;
    output arbitration_model_cancel_request = arbiter.cancel_upstream;
    output arbitration_outcome = arbiter.outcome;
    output segment_model_cancel_request = segment.model_cancel;
    output segmentation_outcome = segment.outcome;
    output speech_cancel_request = speech_cancel_copy.out;
    output tts_status = tts.status;
    output tts_outcome = tts.outcome;
    output tts_resolution = tts.resolved;
    output playback_status = playback.status;
    output playback_outcome = playback.outcome;
    output playback_resolution = playback.resolved;
}
